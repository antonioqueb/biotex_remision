<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_remision" model="ir.sequence">
        <field name="name">Remisión</field>
        <field name="code">biotex.remision</field>
        <field name="prefix">REM-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="product_contract_key" model="product.product">
        <field name="name">Clave de contrato (facturación por máscara)</field>
        <field name="type">service</field>
        <field name="default_code">SRV-CLAVE</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0</field>
    </record>
</odoo>
