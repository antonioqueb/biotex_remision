<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_remision_company" model="ir.rule">
        <field name="name">Remisión: multiempresa</field>
        <field name="model_id" ref="model_biotex_remision"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_remision_delegation" model="ir.rule">
        <field name="name">Remisión: delegación ve las suyas</field>
        <field name="model_id" ref="model_biotex_remision"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('warehouse_id', 'in', user.biotex_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('biotex_base.group_biotex_delegation'))]"/>
    </record>
    <record id="rule_remision_all" model="ir.rule">
        <field name="name">Remisión: compras / dirección / contabilidad ven todo</field>
        <field name="model_id" ref="model_biotex_remision"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('biotex_base.group_biotex_purchase')), (4, ref('biotex_base.group_biotex_direction')), (4, ref('biotex_base.group_biotex_accounting'))]"/>
    </record>
</odoo>
